---
import { languages } from "../utils/i18n.js";
---

<div class="relative group" id="language-selector">
  <button 
    class="flex items-center gap-2 px-3 py-2 text-gray-300 hover:text-pink-400 transition-colors duration-200"
    id="language-button">
    <span class="text-lg">🌐</span>
    <span class="text-sm font-medium" id="current-lang-code">ES</span>
    <span class="w-3 h-3 transition-transform group-hover:rotate-180">▼</span>
  </button>
  
  <!-- Dropdown Menu -->
  <div 
    class="absolute right-0 top-full mt-1 w-32 bg-slate-800 border border-slate-700 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"
    id="language-dropdown">
    <div class="py-1">
      {Object.entries(languages).map(([code, lang]) => (
        <button 
          class="w-full flex items-center gap-2 px-3 py-2 text-sm text-gray-300 hover:bg-slate-700 hover:text-pink-400 transition-colors duration-200 language-option"
          data-lang={code}>
          <span class="text-green-400">{lang.flag}</span>
          <span>{lang.name}</span>
          <span class="ml-auto text-pink-400 checkmark" data-lang={code} style="display: none;">✓</span>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  // Función para cambiar idioma
  function changeLanguage(lang) {
    localStorage.setItem('codeia-language', lang);
    window.location.reload();
  }
  
  // Función para actualizar la interfaz del selector de idioma
  function updateLanguageDisplay() {
    const currentLang = localStorage.getItem('codeia-language') || 'es';
    const currentLangCode = document.getElementById('current-lang-code');
    const checkmarks = document.querySelectorAll('.checkmark');
    
    if (currentLangCode) {
      const languages = {
        es: 'ES',
        en: 'EN'
      };
      currentLangCode.textContent = languages[currentLang] || 'ES';
    }
    
    // Actualizar checkmarks
    checkmarks.forEach(checkmark => {
      if (checkmark instanceof HTMLElement) {
        if (checkmark.getAttribute('data-lang') === currentLang) {
          checkmark.style.display = 'inline';
        } else {
          checkmark.style.display = 'none';
        }
      }
    });
  }
  
  // Agregar event listeners cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', function() {
    // Actualizar la interfaz inicial
    updateLanguageDisplay();
    
    // Event listeners para los botones de idioma
    const languageOptions = document.querySelectorAll('.language-option');
    languageOptions.forEach(option => {
      option.addEventListener('click', function() {
        const lang = this.getAttribute('data-lang');
        changeLanguage(lang);
      });
    });
    
    // Cerrar dropdown al hacer clic fuera
    document.addEventListener('click', function(event) {
      const selector = document.getElementById('language-selector');
      const dropdown = document.getElementById('language-dropdown');
      
      if (selector && dropdown && event.target instanceof Node && !selector.contains(event.target)) {
        dropdown.classList.add('opacity-0', 'invisible');
      }
    });
  });
</script> 