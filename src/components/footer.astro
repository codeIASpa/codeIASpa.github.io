---
import { Icon } from "astro-icon/components";
import { t } from "../utils/i18n.js";
---

<footer class="relative bg-gradient-to-b from-slate-900 to-slate-950 border-t border-slate-800">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(168,85,247,0.05)_0%,transparent_50%)]"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      <!-- Company info -->
      <div class="lg:col-span-2">
        <div class="flex items-center mb-6">
          <span class="text-2xl font-bold text-slate-200">code</span>
          <span class="text-2xl font-bold text-pink-400">IA</span>
        </div>
        <p class="text-slate-400 mb-6 max-w-md leading-relaxed">
          {t('footerDescription')}
        </p>
        <div class="flex gap-4">
          <a href="https://github.com/codeIASpa" target="_blank" rel="noopener" class="w-10 h-10 bg-slate-800 hover:bg-purple-600 rounded-lg flex items-center justify-center transition-colors duration-300">
            <span class="w-5 h-5 text-slate-400 hover:text-white">🐙</span>
          </a>
          <a href="https://linkedin.com/company/codeia" target="_blank" rel="noopener" class="w-10 h-10 bg-slate-800 hover:bg-purple-600 rounded-lg flex items-center justify-center transition-colors duration-300">
            <span class="w-5 h-5 text-slate-400 hover:text-white">💼</span>
          </a>
          <a href="https://twitter.com/codeia" target="_blank" rel="noopener" class="w-10 h-10 bg-slate-800 hover:bg-purple-600 rounded-lg flex items-center justify-center transition-colors duration-300">
            <span class="w-5 h-5 text-slate-400 hover:text-white">🐦</span>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-lg font-semibold text-white mb-6">{t('neuralServices')}</h3>
        <ul class="space-y-3">
          {t('neuralServicesItems').map((item) => (
            <li>
              <a href="#" class="text-slate-400 hover:text-purple-400 transition-colors duration-300">
                {item}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg font-semibold text-white mb-6">{t('contact')}</h3>
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="w-5 h-5 text-purple-400">📞</span>
            <span class="text-slate-400">+56 9 3641 8650</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-5 h-5 text-purple-400">✉️</span>
            <span class="text-slate-400">{t('contactEmail')}</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-5 h-5 text-purple-400">📍</span>
            <span class="text-slate-400">Chile, América Latina</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="w-5 h-5 text-purple-400">⏰</span>
            <span class="text-slate-400">{t('contactTime')}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom section -->
    <div class="border-t border-slate-800 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="text-center md:text-left">
          <p class="text-sm text-slate-500">
            {t('copyright')}
          </p>
        </div>
        <div class="flex gap-6 text-sm">
          <a href="/privacy" class="text-slate-500 hover:text-purple-400 transition-colors duration-300">
            {t('privacy')}
          </a>
          <a href="/terms" class="text-slate-500 hover:text-purple-400 transition-colors duration-300">
            {t('terms')}
          </a>
          <a href="/cookies" class="text-slate-500 hover:text-purple-400 transition-colors duration-300">
            {t('cookies')}
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
