---
import { t } from "../utils/i18n.js";
---

<div class="relative py-20" id="proyectos-destacados">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-gradient-to-b from-slate-900/50 to-transparent"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-purple-500/20 to-pink-500/20 border border-purple-500/30 rounded-full text-sm text-purple-300 mb-6">
        <span class="w-4 h-4">🚀</span>
        <span>{t('projectsBadge')}</span>
      </div>
      
      <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight mb-6">
        <span class="bg-gradient-to-r from-white to-purple-200 bg-clip-text text-transparent">
          {t('projectsTitle')}
        </span>
      </h2>
      
      <p class="text-xl text-slate-400 max-w-4xl mx-auto leading-relaxed">
        {t('projectsDescription')}
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid lg:grid-cols-1 gap-12">
      <!-- Project 1: Fake News Verifier -->
      <div class="group relative p-8 md:p-12 rounded-3xl border border-purple-500/20 bg-gradient-to-br from-purple-500/5 to-pink-500/5 hover:scale-[1.02] transition-all duration-500 hover:shadow-2xl hover:shadow-purple-500/10">
        <div class="grid lg:grid-cols-2 gap-8 items-center">
          <!-- Content -->
          <div class="space-y-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl flex items-center justify-center">
                <span class="w-6 h-6 text-white">🧠</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-white group-hover:text-purple-300 transition-colors duration-300">
                {t('project1Title')}
              </h3>
            </div>
            
            <div class="space-y-4">
              <div>
                <h4 class="text-lg font-semibold text-purple-300 mb-2">{t('project1Objective')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project1ObjectiveText')}
                </p>
              </div>
              
              <div>
                <h4 class="text-lg font-semibold text-purple-300 mb-2">{t('project1Technology')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project1TechnologyText')}
                </p>
              </div>
              
              <div class="flex items-center gap-2 text-pink-400">
                <span class="text-lg">🎞️</span>
                <span class="text-sm italic">{t('project1Animation')}</span>
              </div>
            </div>
          </div>
          
          <!-- Fake News Verification Flow Animation -->
          <div class="relative h-64 lg:h-80 bg-gradient-to-br from-purple-500/10 to-pink-500/10 rounded-2xl border border-purple-500/20 overflow-hidden">
            <!-- Background glow -->
            <div class="absolute inset-0 bg-gradient-to-r from-purple-500/5 to-pink-500/5 animate-pulse"></div>
            
            <!-- Flow elements -->
            <div class="relative z-10 h-full flex items-center justify-center">
              <!-- Twitter/Perplexity Source -->
              <div class="absolute left-4 top-8 w-12 h-12 bg-gradient-to-r from-blue-400 to-cyan-400 rounded-lg flex items-center justify-center animate-bounce">
                <span class="w-6 h-6 text-white">🐦</span>
              </div>
              
              <!-- Arrow 1 -->
              <div class="absolute left-20 top-12 w-8 h-1 bg-gradient-to-r from-purple-400 to-pink-400 rounded-full animate-pulse"></div>
              
              <!-- Semantic Analysis -->
              <div class="absolute left-32 top-6 w-14 h-14 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl flex items-center justify-center animate-pulse">
                <span class="w-7 h-7 text-white">🧠</span>
              </div>
              
              <!-- Arrow 2 -->
              <div class="absolute left-50 top-12 w-8 h-1 bg-gradient-to-r from-purple-400 to-pink-400 rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
              
              <!-- Official Sources -->
              <div class="absolute left-64 top-8 w-12 h-12 bg-gradient-to-r from-green-400 to-emerald-400 rounded-lg flex items-center justify-center animate-bounce" style="animation-delay: 0.3s;">
                <span class="w-6 h-6 text-white">✅</span>
              </div>
              
              <!-- Arrow 3 -->
              <div class="absolute left-80 top-12 w-8 h-1 bg-gradient-to-r from-purple-400 to-pink-400 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
              
              <!-- Secure LLM Response -->
              <div class="absolute right-4 top-6 w-16 h-16 bg-gradient-to-r from-purple-600 to-pink-600 rounded-2xl flex items-center justify-center animate-pulse" style="animation-delay: 0.7s;">
                <span class="w-8 h-8 text-white">🤖</span>
              </div>
              
              <!-- Data flow lines -->
              <div class="absolute inset-0">
                <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-purple-400/30 to-transparent animate-pulse"></div>
                <div class="absolute top-1/3 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-pink-400/30 to-transparent animate-pulse" style="animation-delay: 0.5s;"></div>
              </div>
              
              <!-- Floating particles -->
              <div class="absolute top-4 left-1/4 w-2 h-2 bg-purple-400 rounded-full animate-float"></div>
              <div class="absolute top-8 right-1/3 w-1.5 h-1.5 bg-pink-400 rounded-full animate-float" style="animation-delay: 1s;"></div>
              <div class="absolute bottom-8 left-1/3 w-1 h-1 bg-purple-300 rounded-full animate-float" style="animation-delay: 2s;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 2: FlippyApp -->
      <div class="group relative p-8 md:p-12 rounded-3xl border border-blue-500/20 bg-gradient-to-br from-blue-500/5 to-cyan-500/5 hover:scale-[1.02] transition-all duration-500 hover:shadow-2xl hover:shadow-blue-500/10">
        <div class="grid lg:grid-cols-2 gap-8 items-center">
          <!-- Content -->
          <div class="space-y-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center">
                <span class="w-6 h-6 text-white">🧹</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-white group-hover:text-blue-300 transition-colors duration-300">
                {t('project2Title')}
              </h3>
            </div>
            
            <div class="space-y-4">
              <div>
                <h4 class="text-lg font-semibold text-blue-300 mb-2">{t('project2Objective')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project2ObjectiveText')}
                </p>
              </div>
              
              <div>
                <h4 class="text-lg font-semibold text-blue-300 mb-2">{t('project2Technology')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project2TechnologyText')}
                </p>
              </div>
              
              <div class="flex items-center gap-2 text-cyan-400">
                <span class="text-lg">🎞️</span>
                <span class="text-sm italic">{t('project2Animation')}</span>
              </div>
            </div>
          </div>
          
          <!-- FlippyApp Airbnb Management Flow Animation -->
          <div class="relative h-64 lg:h-80 bg-gradient-to-br from-blue-500/10 to-cyan-500/10 rounded-2xl border border-blue-500/20 overflow-hidden">
            <!-- Background glow -->
            <div class="absolute inset-0 bg-gradient-to-r from-blue-500/5 to-cyan-500/5 animate-pulse"></div>
            
            <!-- Flow elements -->
            <div class="relative z-10 h-full flex items-center justify-center">
              <!-- Guest Checkout -->
              <div class="absolute left-4 top-6 w-12 h-12 bg-gradient-to-r from-red-400 to-pink-400 rounded-lg flex items-center justify-center animate-bounce">
                <span class="w-6 h-6 text-white">👋</span>
              </div>
              
              <!-- Arrow 1 -->
              <div class="absolute left-20 top-12 w-8 h-1 bg-gradient-to-r from-blue-400 to-cyan-400 rounded-full animate-pulse"></div>
              
              <!-- Smart Checklist -->
              <div class="absolute left-32 top-4 w-14 h-14 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center animate-pulse">
                <span class="w-7 h-7 text-white">📋</span>
              </div>
              
              <!-- Arrow 2 -->
              <div class="absolute left-50 top-12 w-8 h-1 bg-gradient-to-r from-blue-400 to-cyan-400 rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
              
              <!-- Cleaning & Maintenance Coordination -->
              <div class="absolute left-64 top-6 w-12 h-12 bg-gradient-to-r from-green-400 to-emerald-400 rounded-lg flex items-center justify-center animate-bounce" style="animation-delay: 0.3s;">
                <span class="w-6 h-6 text-white">🧹</span>
              </div>
              
              <!-- Arrow 3 -->
              <div class="absolute left-80 top-12 w-8 h-1 bg-gradient-to-r from-blue-400 to-cyan-400 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
              
              <!-- Host Report -->
              <div class="absolute right-4 top-4 w-16 h-16 bg-gradient-to-r from-blue-600 to-cyan-600 rounded-2xl flex items-center justify-center animate-pulse" style="animation-delay: 0.7s;">
                <span class="w-8 h-8 text-white">📊</span>
              </div>
              
              <!-- Property visualization -->
              <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 w-20 h-12 bg-gradient-to-r from-blue-400/30 to-cyan-400/30 rounded-lg border border-blue-400/50 flex items-center justify-center">
                <span class="w-4 h-4 text-blue-300">🏠</span>
              </div>
              
              <!-- Data flow lines -->
              <div class="absolute inset-0">
                <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-blue-400/30 to-transparent animate-pulse"></div>
                <div class="absolute top-1/3 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-cyan-400/30 to-transparent animate-pulse" style="animation-delay: 0.5s;"></div>
              </div>
              
              <!-- Floating particles -->
              <div class="absolute top-4 left-1/4 w-2 h-2 bg-blue-400 rounded-full animate-float"></div>
              <div class="absolute top-8 right-1/3 w-1.5 h-1.5 bg-cyan-400 rounded-full animate-float" style="animation-delay: 1s;"></div>
              <div class="absolute bottom-4 left-1/3 w-1 h-1 bg-blue-300 rounded-full animate-float" style="animation-delay: 2s;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 3: Nubbin/Neuralink -->
      <div class="group relative p-8 md:p-12 rounded-3xl border border-green-500/20 bg-gradient-to-br from-green-500/5 to-emerald-500/5 hover:scale-[1.02] transition-all duration-500 hover:shadow-2xl hover:shadow-green-500/10">
        <div class="grid lg:grid-cols-2 gap-8 items-center">
          <!-- Content -->
          <div class="space-y-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-gradient-to-r from-green-500 to-emerald-500 rounded-xl flex items-center justify-center">
                <span class="w-6 h-6 text-white">🧬</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-white group-hover:text-green-300 transition-colors duration-300">
                {t('project3Title')}
              </h3>
            </div>
            
            <div class="space-y-4">
              <div>
                <h4 class="text-lg font-semibold text-green-300 mb-2">{t('project3Objective')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project3ObjectiveText')}
                </p>
              </div>
              
              <div>
                <h4 class="text-lg font-semibold text-green-300 mb-2">{t('project3Status')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project3StatusText')}
                </p>
              </div>
              
              <div class="flex items-center gap-2 text-emerald-400">
                <span class="text-lg">🎞️</span>
                <span class="text-sm italic">{t('project3Animation')}</span>
              </div>
            </div>
          </div>
          
          <!-- Nubbin/Neuralink Brain-AI Interface Animation -->
          <div class="relative h-64 lg:h-80 bg-gradient-to-br from-green-500/10 to-emerald-500/10 rounded-2xl border border-green-500/20 overflow-hidden">
            <!-- Background glow -->
            <div class="absolute inset-0 bg-gradient-to-r from-green-500/5 to-emerald-500/5 animate-pulse"></div>
            
            <!-- Flow elements -->
            <div class="relative z-10 h-full flex items-center justify-center">
              <!-- Human Brain -->
              <div class="absolute left-4 top-8 w-14 h-14 bg-gradient-to-r from-pink-400 to-purple-400 rounded-full flex items-center justify-center animate-pulse">
                <span class="w-7 h-7 text-white">🧠</span>
              </div>
              
              <!-- Neural Connection -->
              <div class="absolute left-20 top-12 w-12 h-1 bg-gradient-to-r from-green-400 to-emerald-400 rounded-full animate-pulse">
                <!-- Neural pulses -->
                <div class="absolute top-0 left-0 w-2 h-2 bg-green-300 rounded-full animate-neural-pulse"></div>
                <div class="absolute top-0 left-1/3 w-2 h-2 bg-emerald-300 rounded-full animate-neural-pulse" style="animation-delay: 0.3s;"></div>
                <div class="absolute top-0 right-0 w-2 h-2 bg-green-300 rounded-full animate-neural-pulse" style="animation-delay: 0.6s;"></div>
              </div>
              
              <!-- Interface Device -->
              <div class="absolute left-36 top-6 w-16 h-16 bg-gradient-to-r from-green-500 to-emerald-500 rounded-2xl flex items-center justify-center animate-pulse">
                <span class="w-8 h-8 text-white">⚡</span>
              </div>
              
              <!-- AI Processing -->
              <div class="absolute left-56 top-8 w-12 h-12 bg-gradient-to-r from-blue-400 to-cyan-400 rounded-lg flex items-center justify-center animate-bounce" style="animation-delay: 0.3s;">
                <span class="w-6 h-6 text-white">🤖</span>
              </div>
              
              <!-- Decision Flow -->
              <div class="absolute left-72 top-12 w-8 h-1 bg-gradient-to-r from-green-400 to-emerald-400 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
              
              <!-- Contextual Response -->
              <div class="absolute right-4 top-6 w-16 h-16 bg-gradient-to-r from-green-600 to-emerald-600 rounded-2xl flex items-center justify-center animate-pulse" style="animation-delay: 0.7s;">
                <span class="w-8 h-8 text-white">💭</span>
              </div>
              
              <!-- Neural network visualization -->
              <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 flex space-x-2">
                <div class="w-3 h-3 bg-green-400/50 rounded-full animate-pulse"></div>
                <div class="w-3 h-3 bg-emerald-400/50 rounded-full animate-pulse" style="animation-delay: 0.2s;"></div>
                <div class="w-3 h-3 bg-green-400/50 rounded-full animate-pulse" style="animation-delay: 0.4s;"></div>
                <div class="w-3 h-3 bg-emerald-400/50 rounded-full animate-pulse" style="animation-delay: 0.6s;"></div>
                <div class="w-3 h-3 bg-green-400/50 rounded-full animate-pulse" style="animation-delay: 0.8s;"></div>
              </div>
              
              <!-- Data flow lines -->
              <div class="absolute inset-0">
                <div class="absolute top-1/2 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-green-400/30 to-transparent animate-pulse"></div>
                <div class="absolute top-1/3 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-emerald-400/30 to-transparent animate-pulse" style="animation-delay: 0.5s;"></div>
              </div>
              
              <!-- Floating particles -->
              <div class="absolute top-4 left-1/4 w-2 h-2 bg-green-400 rounded-full animate-float"></div>
              <div class="absolute top-8 right-1/3 w-1.5 h-1.5 bg-emerald-400 rounded-full animate-float" style="animation-delay: 1s;"></div>
              <div class="absolute bottom-4 left-1/3 w-1 h-1 bg-green-300 rounded-full animate-float" style="animation-delay: 2s;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Call to action -->
    <div class="mt-16 text-center">
      <p class="text-lg text-slate-400 mb-8 max-w-3xl mx-auto">
        {t('projectsCTA')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white px-8 py-4 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-purple-500/25">
          <span class="w-5 h-5">💬</span>
          {t('projectsContactButton')}
        </a>
        <a
          href="/blog"
          class="inline-flex items-center justify-center gap-2 border-2 border-purple-500/50 text-purple-300 hover:bg-purple-500/10 px-8 py-4 rounded-lg font-semibold transition-all duration-300">
          <span class="w-5 h-5">📚</span>
          {t('projectsBlogButton')}
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes float {
    0%, 100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -20px, 0);
    }
  }

  @keyframes neural-pulse {
    0%, 100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.2);
    }
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }

  .animate-neural-pulse {
    animation: neural-pulse 2s ease-in-out infinite;
  }
</style> 