---
import { t } from "../utils/i18n.js";
---

<div class="relative py-20" id="proyectos-destacados">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-gradient-to-b from-slate-900/50 to-transparent"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-purple-500/20 to-pink-500/20 border border-purple-500/30 rounded-full text-sm text-purple-300 mb-6">
        <span class="w-4 h-4">🚀</span>
        <span>{t('projectsBadge')}</span>
      </div>
      
      <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight mb-6">
        <span class="bg-gradient-to-r from-white to-purple-200 bg-clip-text text-transparent">
          {t('projectsTitle')}
        </span>
      </h2>
      
      <p class="text-xl text-slate-400 max-w-4xl mx-auto leading-relaxed">
        {t('projectsDescription')}
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid lg:grid-cols-1 gap-12">
      <!-- Project 1: Fake News Verifier -->
      <div class="group relative p-8 md:p-12 rounded-3xl border border-purple-500/20 bg-gradient-to-br from-purple-500/5 to-pink-500/5 hover:scale-[1.02] transition-all duration-500 hover:shadow-2xl hover:shadow-purple-500/10">
        <div class="grid lg:grid-cols-2 gap-8 items-center">
          <!-- Content -->
          <div class="space-y-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl flex items-center justify-center">
                <span class="w-6 h-6 text-white">🧠</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-white group-hover:text-purple-300 transition-colors duration-300">
                {t('project1Title')}
              </h3>
            </div>
            
            <div class="space-y-4">
              <div>
                <h4 class="text-lg font-semibold text-purple-300 mb-2">{t('project1Objective')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project1ObjectiveText')}
                </p>
              </div>
              
              <div>
                <h4 class="text-lg font-semibold text-purple-300 mb-2">{t('project1Technology')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project1TechnologyText')}
                </p>
              </div>
              
              <div class="flex items-center gap-2 text-pink-400">
                <span class="text-lg">🎞️</span>
                <span class="text-sm italic">{t('project1Animation')}</span>
              </div>
            </div>
          </div>
          
          <!-- Animation Placeholder -->
          <div class="relative h-64 lg:h-80 bg-gradient-to-br from-purple-500/10 to-pink-500/10 rounded-2xl border border-purple-500/20 flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-purple-500/5 to-pink-500/5 animate-pulse"></div>
            <div class="relative z-10 text-center">
              <div class="w-16 h-16 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full flex items-center justify-center mb-4 mx-auto">
                <span class="w-8 h-8 text-white">🔍</span>
              </div>
              <p class="text-purple-300 font-semibold">{t('project1AnimationPlaceholder')}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 2: FlippyApp -->
      <div class="group relative p-8 md:p-12 rounded-3xl border border-blue-500/20 bg-gradient-to-br from-blue-500/5 to-cyan-500/5 hover:scale-[1.02] transition-all duration-500 hover:shadow-2xl hover:shadow-blue-500/10">
        <div class="grid lg:grid-cols-2 gap-8 items-center">
          <!-- Content -->
          <div class="space-y-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center">
                <span class="w-6 h-6 text-white">🧹</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-white group-hover:text-blue-300 transition-colors duration-300">
                {t('project2Title')}
              </h3>
            </div>
            
            <div class="space-y-4">
              <div>
                <h4 class="text-lg font-semibold text-blue-300 mb-2">{t('project2Objective')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project2ObjectiveText')}
                </p>
              </div>
              
              <div>
                <h4 class="text-lg font-semibold text-blue-300 mb-2">{t('project2Technology')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project2TechnologyText')}
                </p>
              </div>
              
              <div class="flex items-center gap-2 text-cyan-400">
                <span class="text-lg">🎞️</span>
                <span class="text-sm italic">{t('project2Animation')}</span>
              </div>
            </div>
          </div>
          
          <!-- Animation Placeholder -->
          <div class="relative h-64 lg:h-80 bg-gradient-to-br from-blue-500/10 to-cyan-500/10 rounded-2xl border border-blue-500/20 flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-blue-500/5 to-cyan-500/5 animate-pulse"></div>
            <div class="relative z-10 text-center">
              <div class="w-16 h-16 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full flex items-center justify-center mb-4 mx-auto">
                <span class="w-8 h-8 text-white">🏠</span>
              </div>
              <p class="text-blue-300 font-semibold">{t('project2AnimationPlaceholder')}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Project 3: Nubbin/Neuralink -->
      <div class="group relative p-8 md:p-12 rounded-3xl border border-green-500/20 bg-gradient-to-br from-green-500/5 to-emerald-500/5 hover:scale-[1.02] transition-all duration-500 hover:shadow-2xl hover:shadow-green-500/10">
        <div class="grid lg:grid-cols-2 gap-8 items-center">
          <!-- Content -->
          <div class="space-y-6">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-gradient-to-r from-green-500 to-emerald-500 rounded-xl flex items-center justify-center">
                <span class="w-6 h-6 text-white">🧬</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-bold text-white group-hover:text-green-300 transition-colors duration-300">
                {t('project3Title')}
              </h3>
            </div>
            
            <div class="space-y-4">
              <div>
                <h4 class="text-lg font-semibold text-green-300 mb-2">{t('project3Objective')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project3ObjectiveText')}
                </p>
              </div>
              
              <div>
                <h4 class="text-lg font-semibold text-green-300 mb-2">{t('project3Status')}</h4>
                <p class="text-slate-400 leading-relaxed">
                  {t('project3StatusText')}
                </p>
              </div>
              
              <div class="flex items-center gap-2 text-emerald-400">
                <span class="text-lg">🎞️</span>
                <span class="text-sm italic">{t('project3Animation')}</span>
              </div>
            </div>
          </div>
          
          <!-- Animation Placeholder -->
          <div class="relative h-64 lg:h-80 bg-gradient-to-br from-green-500/10 to-emerald-500/10 rounded-2xl border border-green-500/20 flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-green-500/5 to-emerald-500/5 animate-pulse"></div>
            <div class="relative z-10 text-center">
              <div class="w-16 h-16 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full flex items-center justify-center mb-4 mx-auto">
                <span class="w-8 h-8 text-white">⚡</span>
              </div>
              <p class="text-green-300 font-semibold">{t('project3AnimationPlaceholder')}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Call to action -->
    <div class="mt-16 text-center">
      <p class="text-lg text-slate-400 mb-8 max-w-3xl mx-auto">
        {t('projectsCTA')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white px-8 py-4 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-purple-500/25">
          <span class="w-5 h-5">💬</span>
          {t('projectsContactButton')}
        </a>
        <a
          href="/blog"
          class="inline-flex items-center justify-center gap-2 border-2 border-purple-500/50 text-purple-300 hover:bg-purple-500/10 px-8 py-4 rounded-lg font-semibold transition-all duration-300">
          <span class="w-5 h-5">📚</span>
          {t('projectsBlogButton')}
        </a>
      </div>
    </div>
  </div>
</div> 