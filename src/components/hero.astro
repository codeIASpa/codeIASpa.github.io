---
import Link from "@components/ui/link.astro";
import { t } from "../utils/i18n.js";
---

<main class="relative overflow-hidden">
  <!-- Background gradient and effects -->
  <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-purple-900/20 to-slate-900"></div>
  <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle at 30px 30px, rgba(156,146,172,0.05) 2px, transparent 2px); background-size: 60px 60px;"></div>
  
  <!-- Neural network pattern -->
  <div class="absolute inset-0 opacity-20">
    <div class="absolute top-20 left-20 w-32 h-32 border border-purple-500/30 rounded-full animate-pulse"></div>
    <div class="absolute top-40 left-40 w-16 h-16 border border-pink-500/30 rounded-full animate-pulse delay-1000"></div>
    <div class="absolute top-60 left-60 w-24 h-24 border border-cyan-500/30 rounded-full animate-pulse delay-2000"></div>
    <div class="absolute top-20 right-20 w-28 h-28 border border-purple-500/30 rounded-full animate-pulse delay-500"></div>
    <div class="absolute top-50 right-50 w-20 h-20 border border-pink-500/30 rounded-full animate-pulse delay-1500"></div>
  </div>

  <div class="relative grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24 min-h-screen">
    <!-- Animation Section - Now on the left and more prominent -->
    <div class="py-6 md:order-2 lg:order-1 relative hero-animation">
      <!-- Brain-Person-NUBBIN Interaction Animation -->
      <div class="relative w-full h-64 md:h-96 flex items-center justify-center">
        <!-- Neural connection lines - Hidden on mobile for performance -->
        <div class="absolute inset-0 hidden md:block">
          <div class="absolute top-1/4 left-1/4 w-1 h-16 bg-gradient-to-b from-purple-500/50 to-transparent animate-pulse"></div>
          <div class="absolute top-1/3 right-1/3 w-1 h-20 bg-gradient-to-b from-pink-500/50 to-transparent animate-pulse delay-500"></div>
          <div class="absolute bottom-1/4 left-1/3 w-1 h-12 bg-gradient-to-b from-cyan-500/50 to-transparent animate-pulse delay-1000"></div>
          <div class="absolute top-1/2 right-1/4 w-1 h-18 bg-gradient-to-b from-green-500/50 to-transparent animate-pulse delay-1500"></div>
        </div>

        <!-- Human Head Silhouette - Simplified for mobile -->
        <div class="absolute left-4 md:left-8 top-1/2 transform -translate-y-1/2">
          <!-- Head -->
          <div class="w-12 h-16 md:w-16 md:h-20 bg-gradient-to-b from-slate-700 to-slate-800 rounded-full border-2 border-purple-500/50 relative shadow-lg">
            <!-- Face features -->
            <div class="absolute top-4 md:top-6 left-1/2 transform -translate-x-1/2 w-6 md:w-8 h-1 bg-slate-600 rounded-full"></div>
            <div class="absolute top-6 md:top-8 left-1/2 transform -translate-x-1/2 w-4 md:w-6 h-1 bg-slate-600 rounded-full"></div>
            <div class="absolute top-8 md:top-10 left-1/2 transform -translate-x-1/2 w-3 md:w-4 h-1 bg-slate-600 rounded-full"></div>
          </div>
          
          <!-- Brain inside head - Simplified for mobile -->
          <div class="absolute top-1 md:top-2 left-1/2 transform -translate-x-1/2 w-10 h-12 md:w-12 md:h-14">
            <!-- Brain lobes -->
            <div class="w-5 h-6 md:w-6 md:h-8 bg-gradient-to-r from-pink-500/60 to-purple-500/60 rounded-full absolute left-0 top-1 md:top-2 animate-pulse shadow-lg"></div>
            <div class="w-5 h-6 md:w-6 md:h-8 bg-gradient-to-r from-cyan-500/60 to-blue-500/60 rounded-full absolute right-0 top-1 md:top-2 animate-pulse delay-500 shadow-lg"></div>
            
            <!-- Neural connections in brain - Reduced for mobile -->
            <div class="absolute top-3 md:top-4 left-1/2 transform -translate-x-1/2 w-1 h-1 md:h-2 bg-purple-400 rounded-full animate-ping shadow-lg"></div>
            <div class="absolute top-5 md:top-6 left-1/2 transform -translate-x-1/2 w-1 h-1 md:h-2 bg-pink-400 rounded-full animate-ping delay-200 shadow-lg"></div>
            <div class="absolute top-7 md:top-8 left-1/2 transform -translate-x-1/2 w-1 h-1 md:h-2 bg-cyan-400 rounded-full animate-ping delay-400 shadow-lg"></div>
          </div>
        </div>

        <!-- Connection line from brain to NUBBIN - Simplified for mobile -->
        <div class="absolute left-16 md:left-24 top-1/2 transform -translate-y-1/2 w-12 md:w-16 h-1 bg-gradient-to-r from-purple-500 via-pink-500 to-cyan-500 animate-pulse shadow-lg">
          <!-- Data particles flowing - Reduced for mobile -->
          <div class="absolute top-0 left-0 w-1 md:w-2 h-1 md:h-2 bg-purple-400 rounded-full animate-data-flow shadow-lg"></div>
          <div class="absolute top-0 left-3 md:left-4 w-1 md:w-2 h-1 md:h-2 bg-pink-400 rounded-full animate-data-flow delay-500 shadow-lg"></div>
          <div class="absolute top-0 left-6 md:left-8 w-1 md:w-2 h-1 md:h-2 bg-cyan-400 rounded-full animate-data-flow delay-1000 shadow-lg"></div>
          <div class="absolute top-0 left-9 md:left-12 w-1 md:w-2 h-1 md:h-2 bg-green-400 rounded-full animate-data-flow delay-1500 shadow-lg"></div>
        </div>

        <!-- Main NUBBIN Device - Responsive sizing -->
        <div class="relative">
          <!-- Device body -->
          <div class="w-24 h-12 md:w-32 md:h-16 bg-gradient-to-r from-slate-800 to-slate-900 rounded-full border-2 border-purple-500/70 shadow-2xl relative overflow-hidden">
            <!-- Glowing center -->
            <div class="absolute inset-1 md:inset-2 bg-gradient-to-r from-purple-500/30 to-pink-500/30 rounded-full animate-pulse"></div>
            
            <!-- Neural interface dots - Reduced for mobile -->
            <div class="absolute top-0.5 md:top-1 left-1 md:left-2 w-1.5 md:w-2 h-1.5 md:h-2 bg-cyan-400 rounded-full animate-ping shadow-lg"></div>
            <div class="absolute top-0.5 md:top-1 left-4 md:left-6 w-1.5 md:w-2 h-1.5 md:h-2 bg-purple-400 rounded-full animate-ping delay-200 shadow-lg"></div>
            <div class="absolute top-0.5 md:top-1 left-7 md:left-10 w-1.5 md:w-2 h-1.5 md:h-2 bg-pink-400 rounded-full animate-ping delay-400 shadow-lg"></div>
            <div class="absolute top-0.5 md:top-1 left-10 md:left-14 w-1.5 md:w-2 h-1.5 md:h-2 bg-green-400 rounded-full animate-ping delay-600 shadow-lg"></div>
            <div class="absolute top-0.5 md:top-1 left-13 md:left-18 w-1.5 md:w-2 h-1.5 md:h-2 bg-blue-400 rounded-full animate-ping delay-800 shadow-lg"></div>
            
            <!-- Bottom row - Reduced for mobile -->
            <div class="absolute bottom-0.5 md:bottom-1 left-1 md:left-2 w-1.5 md:w-2 h-1.5 md:h-2 bg-cyan-400 rounded-full animate-ping delay-1000 shadow-lg"></div>
            <div class="absolute bottom-0.5 md:bottom-1 left-4 md:left-6 w-1.5 md:w-2 h-1.5 md:h-2 bg-purple-400 rounded-full animate-ping delay-1200 shadow-lg"></div>
            <div class="absolute bottom-0.5 md:bottom-1 left-7 md:left-10 w-1.5 md:w-2 h-1.5 md:h-2 bg-pink-400 rounded-full animate-ping delay-1400 shadow-lg"></div>
            <div class="absolute bottom-0.5 md:bottom-1 left-10 md:left-14 w-1.5 md:w-2 h-1.5 md:h-2 bg-green-400 rounded-full animate-ping delay-1600 shadow-lg"></div>
            <div class="absolute bottom-0.5 md:bottom-1 left-13 md:left-18 w-1.5 md:w-2 h-1.5 md:h-2 bg-blue-400 rounded-full animate-ping delay-1800 shadow-lg"></div>
          </div>

          <!-- Brain waves visualization - Simplified for mobile -->
          <div class="absolute -top-6 md:-top-8 left-1/2 transform -translate-x-1/2">
            <div class="flex gap-0.5 md:gap-1">
              <div class="w-0.5 md:w-1 h-3 md:h-4 bg-purple-400 rounded-full animate-pulse shadow-lg"></div>
              <div class="w-0.5 md:w-1 h-4 md:h-6 bg-pink-400 rounded-full animate-pulse delay-100 shadow-lg"></div>
              <div class="w-0.5 md:w-1 h-2 md:h-3 bg-cyan-400 rounded-full animate-pulse delay-200 shadow-lg"></div>
              <div class="w-0.5 md:w-1 h-3 md:h-5 bg-green-400 rounded-full animate-pulse delay-300 shadow-lg"></div>
              <div class="w-0.5 md:w-1 h-3 md:h-4 bg-blue-400 rounded-full animate-pulse delay-400 shadow-lg"></div>
              <div class="w-0.5 md:w-1 h-5 md:h-7 bg-purple-400 rounded-full animate-pulse delay-500 shadow-lg"></div>
              <div class="w-0.5 md:w-1 h-2 md:h-3 bg-pink-400 rounded-full animate-pulse delay-600 shadow-lg"></div>
              <div class="w-0.5 md:w-1 h-3 md:h-5 bg-cyan-400 rounded-full animate-pulse delay-700 shadow-lg"></div>
            </div>
          </div>

          <!-- Neural network connections - Hidden on mobile for performance -->
          <div class="absolute -top-12 md:-top-16 left-1/2 transform -translate-x-1/2 hidden md:block">
            <div class="w-20 md:w-24 h-20 md:h-24 border border-purple-500/50 rounded-full animate-spin-slow shadow-lg"></div>
            <div class="absolute inset-2 w-16 md:w-20 h-16 md:h-20 border border-pink-500/50 rounded-full animate-spin-slow-reverse shadow-lg"></div>
            <div class="absolute inset-4 w-12 md:w-16 h-12 md:h-16 border border-cyan-500/50 rounded-full animate-spin-slow shadow-lg"></div>
          </div>

          <!-- Data streams - Simplified for mobile -->
          <div class="absolute -right-6 md:-right-8 top-1/2 transform -translate-y-1/2">
            <div class="space-y-1 md:space-y-2">
              <div class="w-12 md:w-16 h-0.5 md:h-1 bg-gradient-to-r from-purple-500 to-transparent animate-pulse shadow-lg"></div>
              <div class="w-8 md:w-12 h-0.5 md:h-1 bg-gradient-to-r from-pink-500 to-transparent animate-pulse delay-300 shadow-lg"></div>
              <div class="w-10 md:w-14 h-0.5 md:h-1 bg-gradient-to-r from-cyan-500 to-transparent animate-pulse delay-600 shadow-lg"></div>
            </div>
          </div>

          <!-- Reality validation indicator - Simplified for mobile -->
          <div class="absolute -bottom-6 md:-bottom-8 left-1/2 transform -translate-x-1/2">
            <div class="text-center">
              <div class="text-xs md:text-xs text-purple-400 font-mono mb-1">REALITY CHECK</div>
              <div class="flex gap-0.5 md:gap-1 justify-center">
                <div class="w-1.5 md:w-2 h-1.5 md:h-2 bg-green-400 rounded-full animate-pulse shadow-lg"></div>
                <div class="w-1.5 md:w-2 h-1.5 md:h-2 bg-green-400 rounded-full animate-pulse delay-200 shadow-lg"></div>
                <div class="w-1.5 md:w-2 h-1.5 md:h-2 bg-green-400 rounded-full animate-pulse delay-400 shadow-lg"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- AI Consciousness Cloud - Simplified for mobile -->
        <div class="absolute right-4 md:right-8 top-1/2 transform -translate-y-1/2">
          <!-- AI Brain -->
          <div class="w-12 h-12 md:w-16 md:h-16 bg-gradient-to-r from-purple-500/40 to-pink-500/40 rounded-full border-2 border-purple-500/70 relative shadow-lg">
            <!-- AI neural patterns -->
            <div class="absolute inset-1 md:inset-2 bg-gradient-to-r from-cyan-500/30 to-blue-500/30 rounded-full animate-pulse"></div>
            <div class="absolute top-1 md:top-2 left-1 md:left-2 w-1.5 md:w-2 h-1.5 md:h-2 bg-purple-400 rounded-full animate-ping shadow-lg"></div>
            <div class="absolute top-1 md:top-2 right-1 md:right-2 w-1.5 md:w-2 h-1.5 md:h-2 bg-pink-400 rounded-full animate-ping delay-300 shadow-lg"></div>
            <div class="absolute bottom-1 md:bottom-2 left-1/2 transform -translate-x-1/2 w-1.5 md:w-2 h-1.5 md:h-2 bg-cyan-400 rounded-full animate-ping delay-600 shadow-lg"></div>
          </div>
          
          <!-- AI Label -->
          <div class="absolute -bottom-4 md:-bottom-6 left-1/2 transform -translate-x-1/2 text-xs text-purple-400 font-mono">
            AI
          </div>
        </div>

        <!-- AI Communication Prompt - Responsive positioning -->
        <div class="absolute right-20 md:right-32 top-1/4 md:top-1/3 transform -translate-y-1/2">
          <!-- Speech bubble - Responsive sizing -->
          <div class="relative bg-slate-800 border border-purple-500/50 rounded-lg p-2 md:p-3 shadow-lg max-w-36 md:max-w-48">
            <!-- Tail -->
            <div class="absolute left-0 top-1/2 transform -translate-y-1/2 w-0 h-0 border-l-6 md:border-l-8 border-l-transparent border-t-6 md:border-t-8 border-t-slate-800 border-b-6 md:border-b-8 border-b-transparent"></div>
            <div class="absolute left-0 top-1/2 transform -translate-y-1/2 w-0 h-0 border-l-6 md:border-l-8 border-l-transparent border-t-6 md:border-t-8 border-t-purple-500/50 border-b-6 md:border-b-8 border-b-transparent -ml-0.5 md:-ml-1"></div>
            
            <!-- Typing indicator -->
            <div class="flex items-center gap-1 mb-1 md:mb-2">
              <div class="w-1.5 md:w-2 h-1.5 md:h-2 bg-purple-400 rounded-full animate-pulse"></div>
              <div class="w-1.5 md:w-2 h-1.5 md:h-2 bg-pink-400 rounded-full animate-pulse delay-200"></div>
              <div class="w-1.5 md:w-2 h-1.5 md:h-2 bg-cyan-400 rounded-full animate-pulse delay-400"></div>
              <span class="text-xs text-slate-400 ml-1 md:ml-2">AI typing...</span>
            </div>
            
            <!-- Message content -->
            <div class="text-xs md:text-sm text-slate-200 leading-relaxed">
              <div class="typing-animation" id="ai-message">
                <span class="text-purple-400">Hola, soy tu asistente IA.</span><br>
                <span class="text-pink-400">¿En qué puedo ayudarte hoy?</span>
              </div>
            </div>
            
            <!-- Response options - Hidden on mobile for space -->
            <div class="mt-2 md:mt-3 space-y-0.5 md:space-y-1 hidden md:block">
              <div class="response-option text-xs text-slate-400 hover:text-purple-400 cursor-pointer transition-colors duration-200 hover:bg-slate-700/50 px-2 py-1 rounded">
                💬 "Quiero validar información"
              </div>
              <div class="response-option text-xs text-slate-400 hover:text-pink-400 cursor-pointer transition-colors duration-200 hover:bg-slate-700/50 px-2 py-1 rounded">
                🧠 "Explícame la simbiosis cerebro-IA"
              </div>
              <div class="response-option text-xs text-slate-400 hover:text-cyan-400 cursor-pointer transition-colors duration-200 hover:bg-slate-700/50 px-2 py-1 rounded">
                🔍 "Detección de fake news"
              </div>
            </div>
          </div>
        </div>

        <!-- User Response Indicator - Responsive positioning -->
        <div class="absolute left-20 md:left-32 bottom-1/4 md:bottom-1/3 transform -translate-y-1/2">
          <!-- User thinking bubble - Responsive sizing -->
          <div class="relative bg-slate-700 border border-cyan-500/50 rounded-lg p-2 md:p-3 shadow-lg max-w-32 md:max-w-40">
            <!-- Tail -->
            <div class="absolute right-0 top-1/2 transform -translate-y-1/2 w-0 h-0 border-r-6 md:border-r-8 border-r-transparent border-t-6 md:border-t-8 border-t-slate-700 border-b-6 md:border-b-8 border-b-transparent"></div>
            <div class="absolute right-0 top-1/2 transform -translate-y-1/2 w-0 h-0 border-r-6 md:border-r-8 border-r-transparent border-t-6 md:border-t-8 border-t-cyan-500/50 border-b-6 md:border-b-8 border-b-transparent -mr-0.5 md:-mr-1"></div>
            
            <!-- Thinking dots -->
            <div class="flex items-center gap-1">
              <div class="w-1.5 md:w-2 h-1.5 md:h-2 bg-cyan-400 rounded-full animate-pulse"></div>
              <div class="w-1.5 md:w-2 h-1.5 md:h-2 bg-blue-400 rounded-full animate-pulse delay-300"></div>
              <div class="w-1.5 md:w-2 h-1.5 md:h-2 bg-purple-400 rounded-full animate-pulse delay-600"></div>
              <span class="text-xs text-slate-400 ml-1 md:ml-2">Usuario pensando...</span>
            </div>
            
            <!-- User message -->
            <div class="text-xs md:text-sm text-slate-200 mt-1 md:mt-2">
              <div class="user-message">
                <span class="text-cyan-400">"Interesante, cuéntame más..."</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Connection line from NUBBIN to AI - Simplified for mobile -->
        <div class="absolute right-16 md:right-24 top-1/2 transform -translate-y-1/2 w-12 md:w-16 h-1 bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-500 animate-pulse shadow-lg">
          <!-- Response particles flowing back - Reduced for mobile -->
          <div class="absolute top-0 right-0 w-1 md:w-2 h-1 md:h-2 bg-cyan-400 rounded-full animate-data-flow-reverse shadow-lg"></div>
          <div class="absolute top-0 right-3 md:right-4 w-1 md:w-2 h-1 md:h-2 bg-blue-400 rounded-full animate-data-flow-reverse delay-500 shadow-lg"></div>
          <div class="absolute top-0 right-6 md:right-8 w-1 md:w-2 h-1 md:h-2 bg-purple-400 rounded-full animate-data-flow-reverse delay-1000 shadow-lg"></div>
        </div>

        <!-- Floating data particles - Hidden on mobile for performance -->
        <div class="absolute inset-0 pointer-events-none hidden md:block">
          <div class="absolute top-10 left-10 w-2 h-2 bg-purple-400 rounded-full animate-float shadow-lg"></div>
          <div class="absolute top-20 right-20 w-1 h-1 bg-pink-400 rounded-full animate-float delay-1000 shadow-lg"></div>
          <div class="absolute bottom-20 left-20 w-1 h-1 bg-cyan-400 rounded-full animate-float delay-2000 shadow-lg"></div>
          <div class="absolute bottom-10 right-10 w-2 h-2 bg-green-400 rounded-full animate-float delay-3000 shadow-lg"></div>
          <div class="absolute top-1/2 left-10 w-1 h-1 bg-blue-400 rounded-full animate-float delay-1500 shadow-lg"></div>
          <div class="absolute top-1/2 right-10 w-1 h-1 bg-purple-400 rounded-full animate-float delay-2500 shadow-lg"></div>
        </div>

        <!-- Neural glow effect - Reduced for mobile -->
        <div class="absolute inset-0 bg-gradient-to-r from-purple-500/10 md:from-purple-500/20 via-pink-500/10 md:via-pink-500/20 to-cyan-500/10 md:to-cyan-500/20 blur-2xl md:blur-3xl animate-pulse"></div>
      </div>
    </div>
    
    <!-- Content Section - Now on the right -->
    <div class="relative z-10 md:order-1 lg:order-2 px-4 md:px-0">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 md:px-4 py-1.5 md:py-2 bg-gradient-to-r from-purple-500/20 to-pink-500/20 border border-purple-500/30 rounded-full text-xs md:text-sm text-purple-300 mb-4 md:mb-6">
        <span class="w-3 md:w-4 h-3 md:h-4">🧠</span>
        <span>{t('badge')}</span>
      </div>

      <h1 class="text-3xl md:text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter leading-tight">
        <span class="bg-gradient-to-r from-white via-purple-200 to-pink-200 bg-clip-text text-transparent">
          {t('title1')}
        </span>
        <br />
        <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-cyan-400 bg-clip-text text-transparent">
          {t('title2')}
        </span>
      </h1>
      
      <p class="text-base md:text-xl mt-4 md:mt-6 text-slate-300 max-w-xl leading-relaxed">
        <span class="text-purple-400 font-semibold">Especialistas en detección de fake news</span> 
        con inteligencia artificial. Construimos dispositivos inteligentes que leen tu mente 
        y procesan tus agentes en tiempo real, eliminando la paranoia de la interacción cerebro-IA.
      </p>
      
      <div class="mt-6 md:mt-8 flex flex-col sm:flex-row gap-3 md:gap-4">
        <Link
          href="https://api.whatsapp.com/send?phone=56936418650"
          target="_blank"
          class="flex gap-2 items-center justify-center bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white px-6 md:px-8 py-3 md:py-4 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-purple-500/25 text-sm md:text-base"
          rel="noopener">
          <span class="w-4 md:w-5 h-4 md:h-5">🧠</span>
          {t('ctaPrimary')}
        </Link>
        <Link
          size="lg"
          style="outline"
          rel="noopener"
          href="https://github.com/codeIASpa"
          class="flex gap-2 items-center justify-center border-2 border-purple-500/50 text-purple-300 hover:bg-purple-500/10 px-6 md:px-8 py-3 md:py-4 rounded-lg font-semibold transition-all duration-300 text-sm md:text-base"
          target="_blank">
          <span class="w-3 md:w-4 h-3 md:h-4">🔗</span>
          {t('ctaSecondary')}
        </Link>
      </div>

      <!-- AI Partners -->
      <div class="mt-8 md:mt-12">
        <p class="text-xs md:text-sm text-slate-400 mb-3 md:mb-4">{t('technologies')}</p>
        <div class="flex flex-col sm:flex-row gap-3 md:gap-4 items-start sm:items-center">
          <div class="flex items-center gap-2 px-2 md:px-3 py-1.5 md:py-2 bg-gradient-to-r from-green-500/20 to-emerald-500/20 border border-green-500/30 rounded-lg">
            <span class="w-3 md:w-4 h-3 md:h-4 text-green-400">🤖</span>
            <span class="text-xs md:text-sm text-green-300">OpenAI GPT-4</span>
          </div>
          <div class="flex items-center gap-2 px-2 md:px-3 py-1.5 md:py-2 bg-gradient-to-r from-blue-500/20 to-cyan-500/20 border border-blue-500/30 rounded-lg">
            <span class="w-3 md:w-4 h-3 md:h-4 text-blue-400">🧬</span>
            <span class="text-xs md:text-sm text-blue-300">Anthropic Claude</span>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="mt-8 md:mt-12 grid grid-cols-3 gap-4 md:gap-8">
        <div class="text-center">
          <div class="text-xl md:text-2xl font-bold text-purple-400">{t('stats1')}</div>
          <div class="text-xs md:text-sm text-slate-400">{t('stats1Label')}</div>
        </div>
        <div class="text-center">
          <div class="text-xl md:text-2xl font-bold text-pink-400">{t('stats2')}</div>
          <div class="text-xs md:text-sm text-slate-400">{t('stats2Label')}</div>
        </div>
        <div class="text-center">
          <div class="text-xl md:text-2xl font-bold text-cyan-400">{t('stats3')}</div>
          <div class="text-xs md:text-sm text-slate-400">{t('stats3Label')}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Video section -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 pb-8 md:pb-16">
    <div class="text-center mb-6 md:mb-8">
      <h3 class="text-xl md:text-2xl font-bold text-white mb-2">{t('videoTitle')}</h3>
      <p class="text-sm md:text-base text-slate-400">{t('videoDescription')}</p>
    </div>
    <div class="relative">
      <iframe
        width="560"
        height="315"
        src="https://www.youtube.com/embed/AGtJHSnOtCs?start=29"
        title="CodeIA - Psicología de Conversación IA"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        class="w-full max-w-4xl aspect-video rounded-lg shadow-2xl"
        loading="lazy"
      ></iframe>
      <!-- Neural glow effect behind video -->
      <div class="absolute inset-0 bg-gradient-to-r from-purple-500/20 via-pink-500/20 to-cyan-500/20 blur-3xl -z-10 rounded-lg"></div>
    </div>
  </div>
</main>

<style>
  @keyframes float {
    0%, 100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -20px, 0);
    }
  }

  @keyframes neural-pulse {
    0%, 100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.1);
    }
  }

  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes spin-slow-reverse {
    from {
      transform: rotate(360deg);
    }
    to {
      transform: rotate(0deg);
    }
  }

  @keyframes data-flow {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translateX(64px);
      opacity: 0;
    }
  }

  @keyframes data-flow-reverse {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translateX(-64px);
      opacity: 0;
    }
  }

  @keyframes glow {
    0%, 100% {
      box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);
    }
    50% {
      box-shadow: 0 0 40px rgba(168, 85, 247, 0.8);
    }
  }

  @keyframes typing {
    0%, 50%, 100% {
      opacity: 1;
    }
    25%, 75% {
      opacity: 0.3;
    }
  }

  @keyframes message-change {
    0%, 80% {
      opacity: 1;
      transform: translateY(0);
    }
    90%, 100% {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  .animate-pulse {
    animation: neural-pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }

  .animate-spin-slow-reverse {
    animation: spin-slow-reverse 15s linear infinite;
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-data-flow {
    animation: data-flow 2s linear infinite;
  }

  .animate-data-flow-reverse {
    animation: data-flow-reverse 2s linear infinite;
  }

  .typing-animation {
    animation: typing 2s ease-in-out infinite;
  }

  .message-change {
    animation: message-change 8s ease-in-out infinite;
  }

  .delay-100 {
    animation-delay: 0.1s;
  }

  .delay-200 {
    animation-delay: 0.2s;
  }

  .delay-300 {
    animation-delay: 0.3s;
  }

  .delay-400 {
    animation-delay: 0.4s;
  }

  .delay-500 {
    animation-delay: 0.5s;
  }

  .delay-600 {
    animation-delay: 0.6s;
  }

  .delay-700 {
    animation-delay: 0.7s;
  }

  .delay-800 {
    animation-delay: 0.8s;
  }

  .delay-1000 {
    animation-delay: 1s;
  }

  .delay-1200 {
    animation-delay: 1.2s;
  }

  .delay-1400 {
    animation-delay: 1.4s;
  }

  .delay-1500 {
    animation-delay: 1.5s;
  }

  .delay-1600 {
    animation-delay: 1.6s;
  }

  .delay-1800 {
    animation-delay: 1.8s;
  }

  .delay-2000 {
    animation-delay: 2s;
  }

  .delay-2500 {
    animation-delay: 2.5s;
  }

  .delay-3000 {
    animation-delay: 3s;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-pulse,
    .animate-spin-slow,
    .animate-spin-slow-reverse,
    .animate-float,
    .animate-data-flow,
    .animate-data-flow-reverse {
      animation: none;
    }
  }
</style>

<script>
  // Sistema de mensajes dinámicos para la animación
  const aiMessages = [
    {
      text: '<span class="text-purple-400">Hola, soy tu asistente IA.</span><br><span class="text-pink-400">¿En qué puedo ayudarte hoy?</span>',
      duration: 4000
    },
    {
      text: '<span class="text-cyan-400">Detecto que buscas</span><br><span class="text-purple-400">información confiable.</span>',
      duration: 3500
    },
    {
      text: '<span class="text-pink-400">Puedo ayudarte a</span><br><span class="text-green-400">validar cualquier dato.</span>',
      duration: 3500
    },
    {
      text: '<span class="text-blue-400">¿Quieres explorar</span><br><span class="text-purple-400">la simbiosis cerebro-IA?</span>',
      duration: 4000
    },
    {
      text: '<span class="text-green-400">Juntos podemos</span><br><span class="text-pink-400">eliminar la paranoia.</span>',
      duration: 3500
    }
  ];

  const userMessages = [
    {
      text: '<span class="text-cyan-400">"Interesante, cuéntame más..."</span>',
      duration: 3000
    },
    {
      text: '<span class="text-blue-400">"¿Cómo funciona?"</span>',
      duration: 2500
    },
    {
      text: '<span class="text-purple-400">"Me gustaría probar"</span>',
      duration: 3000
    },
    {
      text: '<span class="text-green-400">"Suena fascinante"</span>',
      duration: 2500
    },
    {
      text: '<span class="text-pink-400">"¿Es seguro?"</span>',
      duration: 3000
    }
  ];

  let aiMessageIndex = 0;
  let userMessageIndex = 0;

  function updateAIMessage() {
    const aiMessageElement = document.getElementById('ai-message');
    if (aiMessageElement) {
      const message = aiMessages[aiMessageIndex];
      aiMessageElement.innerHTML = message.text;
      aiMessageElement.classList.add('message-change');
      
      setTimeout(() => {
        aiMessageIndex = (aiMessageIndex + 1) % aiMessages.length;
        updateAIMessage();
      }, message.duration);
    }
  }

  function updateUserMessage() {
    const userMessageElements = document.querySelectorAll('.user-message');
    if (userMessageElements.length > 0) {
      const message = userMessages[userMessageIndex];
      userMessageElements.forEach(element => {
        element.innerHTML = message.text;
        element.classList.add('message-change');
      });
      
      setTimeout(() => {
        userMessageIndex = (userMessageIndex + 1) % userMessages.length;
        updateUserMessage();
      }, message.duration + 1000); // Delay adicional para sincronización
    }
  }

  // Iniciar las animaciones cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(() => {
      updateAIMessage();
      updateUserMessage();
    }, 2000); // Delay inicial
  });

  // Interactividad con las opciones de respuesta
  document.addEventListener('click', function(event) {
    if (event.target && event.target instanceof Element && event.target.closest('.response-option')) {
      const option = event.target.closest('.response-option');
      if (option) {
        const text = option.textContent?.trim() || '';
        
        // Simular respuesta de la IA
        const aiMessageElement = document.getElementById('ai-message');
        if (aiMessageElement) {
          aiMessageElement.innerHTML = `<span class="text-green-400">Procesando: "${text}"</span>`;
          aiMessageElement.classList.add('typing-animation');
          
          setTimeout(() => {
            aiMessageElement.innerHTML = `<span class="text-purple-400">Perfecto, te ayudo con eso.</span><br><span class="text-cyan-400">¿Quieres continuar?</span>`;
            aiMessageElement.classList.remove('typing-animation');
          }, 2000);
        }
      }
    }
  });
</script>
