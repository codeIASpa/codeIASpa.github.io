---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";

// Filter team entries with 'draft: false' & date before current date
const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});
---

<Layout title="About">
  <Container class="text-slate-300">
    <Sectionhead>
      <Fragment slot="title">Nuestra visión</Fragment>
      <Fragment slot="desc">
        <p class="text-violet-500">
          Innovar y transformar con inteligencia artificial y tecnología para el desarrollo de Chile y América Latina.
        </p>
      </Fragment>
    </Sectionhead>

    <div class="flex flex-col gap-3 mx-auto max-w-4xl mt-16">
      <h2 class="font-bold text-3xl text-pink-400">
        Construyendo soluciones tecnológicas para un futuro mejor.
      </h2>
      <p class="text-lg leading-relaxed text-slate-400">
        En <strong>CodeIA</strong>, somos un equipo apasionado y diverso, comprometido con la creación de tecnologías de inteligencia artificial que resuelvan problemas reales y generen impacto en la sociedad. Nuestra meta es brindar herramientas que impulsen la innovación y contribuyan al crecimiento de empresas y comunidades en toda la región.
      </p>
      <p class="text-lg leading-relaxed text-slate-400">
        Creemos que la diversidad es nuestra fortaleza. Nuestro equipo multicultural combina talentos únicos y experiencias diversas para co-crear soluciones tecnológicas que marquen la diferencia.
      </p>
    </div>
  </Container>
</Layout>
